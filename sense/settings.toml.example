# Copy this file to settings.toml on the CIRCUITPY drive and fill in your
# own values. settings.toml is read once at boot - re-plug or reset the
# board after editing it.

CIRCUITPY_WIFI_SSID = "your-wifi-name"
CIRCUITPY_WIFI_PASSWORD = "your-wifi-password"

# Enables CircuitPython's Web Workflow (wireless code editing + file access
# over http://<board>.local/) - optional, but very useful during development
# so you don't need USB for every code change.
CIRCUITPY_WEB_API_PASSWORD = "choose-a-password"
CIRCUITPY_WEB_INSTANCE_NAME = "oracle-sense"

# The Uno Q's /consult endpoint (see ../suziq). Use its IP or mDNS hostname
# on your local network, e.g. "http://192.168.1.50:7000/consult".
ORACLE_URL = "http://<your-uno-q-address>:7000/consult"
